# -- .env --

# API Configuration
API_BASE_URL=https://api.frankfurter.dev/v2
API_TIMEOUT=10

# Currencies to track
PRIMARY_CURRENCIES=USD,EUR,GBP
WATCH_CURRENCIES=JPY,CHF,CAD

# Alert thresholds (format: BASE:TARGET:THRESHOLD:DIRECTION)
ALERTS=USD:EUR:0.85:above,USD:GBP:0.75:below

# Scheduling
FETCH_INTERVAL_HOURS=1

# Database
DB_PATH=currency_exchange_rates.db

# Logging
LOG_FILE=logs/currency_monitor.log
LOG_LEVEL=INFO
CONSOLE_LEVEL=INFO
