# -- .env --

# API Configuration
API_BASE_URL=https://api.frankfurter.dev/v2
API_TIMEOUT=10

# Currencies to track
PRIMARY_CURRENCIES=USD,EUR,GBP
WATCH_CURRENCIES=JPY,CHF,CAD

# Scheduling
FETCH_INTERVAL_HOURS=1

# Database
DB_PATH=currency_exchange_rates.db

# Logging
LOG_FILE=logs/currency_monitor.log
LOG_LEVEL=INFO
CONSOLE_LEVEL=INFO
